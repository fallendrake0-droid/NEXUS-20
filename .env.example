# Mineflayer AI Swarm — Example Configuration (.env.example)
# Copy to .env (gitignored) and replace placeholder values. NEVER commit real secrets.

# Galaxy A06 Master Controller mandatory V8 memory cap (PERFORMANCE_PLAN.md §1)
NODE_OPTIONS=--max-old-space-size=256

# Process role & environment profile: authorised_online | private_offline_test
SWARM_ROLE=master
SWARM_ENV_PROFILE=authorised_online

# NEXUS-20 runtime defaults:
# Operating Mode: SYNCHRONIZED | DISTRIBUTED | HYBRID
SWARM_OPERATING_MODE=HYBRID
# Performance Profile: ULTRA_LOW | LOW | BALANCED | PERFORMANCE | MAXIMUM_THROUGHPUT
SWARM_PERFORMANCE_PROFILE=BALANCED

# Network & TLS (non-loopback bind requires TLS certificates or explicit SWARM_TRUST_EDGE_TLS_PROXY=true)
SWARM_BIND_HOST=127.0.0.1
SWARM_PORT=8443
SWARM_HTTP_ENABLED=true
SWARM_TLS_ENABLED=false
SWARM_TRUST_EDGE_TLS_PROXY=false
# SWARM_TLS_CERT_PATH=/data/data/com.termux/files/home/.config/swarm/server.crt
# SWARM_TLS_KEY_PATH=/data/data/com.termux/files/home/.config/swarm/server.key
# SWARM_TLS_CA_PATH=/data/data/com.termux/files/home/.config/swarm/ca.crt

# Swarm capacity (default 20; extensible via SWARM_MAX_ARCHITECTURAL_BOTS; phoneLocalBotSlots MUST stay 0)
SWARM_MAX_ARCHITECTURAL_BOTS=20
SWARM_GLOBAL_MAX_BOTS=20
SWARM_ENABLED_BOTS=2
SWARM_PHONE_LOCAL_BOT_SLOTS=0
SWARM_HEARTBEAT_INTERVAL_MS=5000
SWARM_LEASE_DURATION_MS=30000
SWARM_MIN_ASSIGNMENT_HOLD_MS=8000

# Remote-only self-hosted Ollama over private LAN/VPN (£0 inference; NEVER localhost on phone, NEVER paid APIs)
SWARM_AI_ENABLED=true
# SWARM_OLLAMA_URL=https://10.8.0.12:11434
SWARM_OLLAMA_MODEL=unresolved
SWARM_AI_MAX_CONCURRENT=1
SWARM_AI_MAX_QUEUE=3
SWARM_AI_CONNECT_TIMEOUT_MS=2500
SWARM_AI_TIMEOUT_MS=8000
SWARM_AI_COLD_TIMEOUT_MS=20000

# Native POSIX SQLite WAL path inside Termux $HOME (NEVER /sdcard)
SWARM_DB_PATH=./data/swarm.db
SWARM_BACKUP_DIR=./data/backups

# Bounded structured logging (5 MiB x 3 rotation)
SWARM_LOG_LEVEL=info
# SWARM_LOG_PATH=./data/logs/master.jsonl
SWARM_LOG_MAX_BYTES=5242880
SWARM_LOG_MAX_FILES=3

# In-game chat control (disabled by default; locked off in private_offline_test)
SWARM_CHAT_ENABLED=false
SWARM_CHAT_PREFIX=!swarm
SWARM_CHAT_ALLOWED_UUIDS=

# Local CLI operator token placeholder (replace locally with 32-byte random hex; 0600 perms)
SWARM_CLI_TOKEN=replace_with_generated_32_byte_hex_secret_do_not_commit

# Optional initial admin bootstrap on empty DB (leave unset to use Web UI one-time setup screen)
# SWARM_ADMIN_USERNAME=admin
# SWARM_ADMIN_PASSWORD=replace_with_min_10_char_password

# Distributed WorkerHost settings (used when SWARM_ROLE=worker)
SWARM_MASTER_URL=http://192.168.1.168:8443
SWARM_WORKER_ID=worker-1
SWARM_WORKER_MAX_SLOTS=5
SWARM_SPAWN_STAGGER_MS=2500
SWARM_WORKER_POLL_MS=1000
# SWARM_BOOTSTRAP_TOKEN=paste_single_use_bootstrap_token_from_master
SWARM_WORKER_STATE_PATH=./data/worker-1-credentials.json
SWARM_MC_HOST=thebasement-wUr4.aternos.me
SWARM_MC_PORT=25565
SWARM_MC_SERVER_ID=thebasement-aternos
# Sticky deterministic bot usernames (Nexus_01, Nexus_02, ...) so bots keep all server items across restarts
SWARM_BOT_NAME_PREFIX=Nexus
SWARM_WORKER_BOT_COUNT=2
SWARM_WORKER_BOT_START_INDEX=1
# Optional explicit override: SWARM_WORKER_BOTS=bot-01:Nexus_01,bot-02:Nexus_02
SWARM_WORKER_SIMULATION=false

